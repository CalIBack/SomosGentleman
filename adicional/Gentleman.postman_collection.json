                    }
                },
                {
                    "name": "Compartir (Logueado)",
                    "request": {
                        "method": "POST",
                        "url": "http://localhost/SomosGentleman/backend/compartidos",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"lookbook_id\": 3,\n    \"usuario_receptor_id\": 1\n}"
                        },
                        "description": "Solo el dueño del lookbook (o un admin). Devuelve 409 si ya estaba compartido con esa persona y 400 si intentás compartirlo con su propio autor.\n\nEjemplo: logueado como 'Login (Cliente)', comparte el lookbook 3 con el admin (id 1)."
                    }
                },
                {
                    "name": "Dejar de Compartir (Logueado)",
                    "request": {
                        "method": "DELETE",
                        "url": "http://localhost/SomosGentleman/backend/compartidos/1",
                        "description": "Pueden hacerlo el dueño (deja de compartir), el receptor (lo quita de su lista) o un admin."
                    }
                }
            ]
        },
        {
