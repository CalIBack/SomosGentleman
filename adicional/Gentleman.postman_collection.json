                        "method": "GET",
                        "url": "http://localhost/SomosGentleman/backend/resenas?producto_id=1"
                    }
                },
                {
                    "name": "Crear (Logueado)",
                    "request": {
                        "method": "POST",
                        "header": [{"key": "Content-Type","value": "application/json"}],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"producto_id\": 1,\n    \"calificacion\": 5,\n    \"comentario\": \"Excelente calidad, el calce es perfecto.\"\n}"
                        },
                        "url": "http://localhost/SomosGentleman/backend/resenas"
                    }
                },
                {
                    "name": "Actualizar (Logueado)",
                    "request": {
                        "method": "PATCH",
                        "header": [{"key": "Content-Type","value": "application/json"}],
